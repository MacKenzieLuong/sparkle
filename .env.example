MOCK=true
HUAWEI_API_KEY=
HUAWEI_BASE_URL=https://yibuapi.com/v1
# The flash variants are not accessible on this gateway's key, which reads as
# the model identifying nothing. See backend/.env.example for the full set.
HUAWEI_MODEL=qwen3.5-omni-plus-realtime
CAMERA=fake
DRIVER=fake
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CONTROL_INTERVAL=5
SHORT_INTERVAL=1
SHORT_INTERVAL_AREA=0.15
# How many degrees of heading one model decision may command before the car
# coasts straight until the next reply. Lower = less overshoot past the target.
# Requires calibration.json (run `python calibrate.py`) for degrees per turn-
# throttle; without it the uncalibrated ROTATION_BUDGET (throttle-seconds)
# below is used instead, and the banner says so.
ROTATION_BUDGET_DEG=30
CALIBRATION_FILE=calibration.json
# Throttle-seconds fallback for an uncalibrated rotation budget.
ROTATION_BUDGET=0.5
TB6612_AIN1=17
TB6612_AIN2=27
TB6612_PWMA=13
TB6612_BIN1=16
TB6612_BIN2=20
TB6612_PWMB=12
TB6612_STBY=21