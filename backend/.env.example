# Copy to backend/.env and edit. run-backend-local.sh sources this file and
# exports it, so these reach the server; running `python server.py` yourself
# does NOT read it, because the backend does not load dotenv itself.
#
# Values are the live-car configuration. For a dry run on a laptop set
# MOCK=true, CAMERA=fake, DRIVER=fake, SPEECH_PROVIDER=fake and nothing moves
# or costs anything.

# --- what is real -----------------------------------------------------------
MOCK=false
CAMERA=rpicam
# 180 if the camera is mounted inverted. Check a real photo before trusting it:
#   .venv/bin/python cli.py "anything" --save cam
# An upside-down frame wrecks identification while everything else looks fine.
CAMERA_ROTATION=180
DRIVER=tb6612
HOST=0.0.0.0
PORT=8000

# --- model ------------------------------------------------------------------
# This is the model run-demo.sh runs on, and run-demo.sh identifies targets. It
# reaches that by setting no model at all and falling through to DEFAULT_MODEL
# in vision.py, so the name is spelled out here only to stop it drifting.
#
# Do NOT put qwen3.5-omni-plus-realtime here. That is the WebSocket Realtime
# model from realtime_probe.py, it is not served over this HTTP path, and
# setting it makes every reply come back empty -- which looks exactly like the
# car being unable to identify anything, with a healthy camera and a healthy
# loop. Any change here must be checked first with:
#   HUAWEI_MODEL=<name> .venv/bin/python cli.py "the red ball" --raw
HUAWEI_BASE_URL=https://yibuapi.com/v1
HUAWEI_MODEL=qwen3.8-omni-flash
# Unset on purpose: it falls back to HUAWEI_MODEL, which is the combination
# run-demo.sh uses. Set it only to point speech at a different model.
# HUAWEI_VOICE_MODEL=
# HUAWEI_API_KEY=your-provider-key
SPEECH_PROVIDER=qwen
STOP_WORD=stop
RESUME_WORD=resume

# --- perception -------------------------------------------------------------
# Image tokens go as the area: 640x480 is 300 of them, 320x240 is 80. Small is
# cheap and fast but harder to identify from; raise these first if the model
# keeps missing a target that is clearly in the saved frame.
VISION_WIDTH=320
VISION_HEIGHT=240
VISION_EXPLAIN=false
# Requests in flight. One call takes 2.5-4.3s, so the only way to hear from the
# model more often is to overlap them. Costs one full call per worker.
VISION_CONCURRENCY=2
VISION_STAGGER=1.2
# Minimum gap between successive inference frames across all workers, so they
# sample the whole cycle instead of firing together. Ideal is roughly
# cycle / VISION_CONCURRENCY. A late worker captures immediately regardless,
# so setting this too high costs nothing; too low lets frames bunch.
VISION_SPACING=1.5
# Local tracking carries the box between replies, so the car steers on a box
# tens of milliseconds old rather than seconds.
TRACK=true
TRACK_HZ=20
TRACK_MAX_AGE=1.5

# --- chassis trim (from calibrate.py) ---------------------------------------
# The two sides are not loaded equally: equal throttle does not drive straight,
# and the heavier side needs more PWM before it moves at all. Leaving the
# minimums at 0 is why a car can sit humming instead of easing forward.
# Measured by calibrate.py with the wheel LIFTED, so these are free-spinning
# numbers. Loaded breakaway on the floor is higher -- raise them if a wheel
# buzzes without turning.
MOTOR_LEFT_MIN=0.20
MOTOR_RIGHT_MIN=0.15
# Brief higher throttle when a wheel starts from rest or reverses, to break
# static friction. Below breakaway a motor only buzzes, so without this the
# slowest usable throttle is the starting one and gentle turns cannot happen
# at all. 0 disables it. Raise until small corrections always move the car;
# lower if starts are jerky.
MOTOR_KICK=0.45
MOTOR_KICK_SECONDS=0.15
MOTOR_LEFT_SCALE=0.95
MOTOR_RIGHT_SCALE=1.0

# --- steering ---------------------------------------------------------------
BASE_SPEED=0.22
TURN_GAIN=0.35
# Seconds of lead in the steering error, cancelling the rotation the car keeps
# after power is cut. 0 is the plain proportional turn, which overshoots on any
# chassis with momentum. Set it from the coast calibrate.py measures, and halve
# it if the car starts hunting about the centre.
TURN_LEAD=0
DEAD_ZONE=0.15
# The in-place scan pivot, and the one thing the stiction minimums put a
# floor under: as this approaches 0 the wheels still receive MOTOR_*_MIN,
# because below that they do not turn at all. 0.05 is about as slow as this
# chassis pivots -- roughly 0.24 at the left wheel, against a 0.20 floor.
SEARCH_SPEED=0.05
ARRIVED_AREA_FRACTION=0.6
# Degrees of heading one decision may command. Only used once calibration.json
# has a usable "pivots" block; without it the car falls back to ROTATION_BUDGET
# in throttle-seconds and the startup banner says UNcalibrated.
ROTATION_BUDGET_DEG=30
ROTATION_BUDGET=0.7

# --- pacing and limits ------------------------------------------------------
CONTROL_INTERVAL=0
CONTROL_HZ=10
STALE_AFTER=5
HEARTBEAT_TIMEOUT=3
MAX_RUN_SECONDS=120
MAX_COST_USD=0.25

# --- motor pins (SparkFun handoff) ------------------------------------------
# Motor A = left wheel, Motor B = right wheel.
TB6612_AIN1=17
TB6612_AIN2=27
TB6612_PWMA=13
TB6612_BIN1=16
TB6612_BIN2=20
TB6612_PWMB=12
TB6612_STBY=21

# --- fake providers only ----------------------------------------------------
FAKE_SCENARIO=approach
FAKE_VOICE_TRANSCRIPT="go to the blue flag"
